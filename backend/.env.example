# ────────────────────────────────────────────────────────
# 觉学 Backend · 本地开发环境变量
# 复制为 .env 后填入真实值。.env 已在 .gitignore 忽略。
# ────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (docker-compose 默认端口 5433)
DATABASE_URL="postgresql://juexue:juexue_dev@localhost:5433/juexue?schema=public"

# JWT (开发阶段随便)
JWT_SECRET=replace_me_in_production

# LLM · MiniMax (主通路)
# https://platform.minimaxi.com/
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=abab6.5s-chat

# LLM · MiniMax M2.7（可选 · 特定任务用 · 留空回落主 KEY）
MINIMAX_M27_API_KEY=

# LLM · Claude (兜底 · 可留空则不启用)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# 额度阈值（供 Gateway 读取默认配置）
LLM_YEARLY_RESERVE_PERCENT=5
LLM_FALLBACK_MONTHLY_BUDGET_USD=200

# CORS · 生产白名单（逗号分隔）· dev 自动全开
# 同源部署（nginx 反代）可留空；跨域部署填前端域名
# 例：CORS_ORIGINS=https://app.juexue.com,https://admin.juexue.com
CORS_ORIGINS=

# 法本抓取 · 亚洲中转节点（admin 后台「导入法本」可切换 local/asia）
# 留空 → 后台切到 asia 时会拒绝（避免静默走错路径）
# 部署详见 asia-relay/README.md
ASIA_RELAY_URL=
ASIA_RELAY_TOKEN=

# Dev-only: 简化身份注入（生产切 JWT）
DEV_FAKE_USER_ID=dev_user_001

# ────────────────────────────────────────────────────────
# OSS · 观修视频 / PDF 上传
# 通过 ssh + scp 投递到独立 OSS 服务器（v1 简方案 · 后续可换 R2）
# 留空 → admin 上传接口报错
# ────────────────────────────────────────────────────────
# 形如 user@129.213.64.152
OSS_HOST=
# 私钥本机绝对路径（chmod 600）· 例 /home/juexue/.ssh/oss_id_ed25519
OSS_SSH_KEY=
# 远端目标根目录（不以 / 结尾）· 例 /var/www/oss/meditations
OSS_REMOTE_DIR=
# 公网访问根 URL（不以 / 结尾）· 例 https://oss.juexue.com/meditations
OSS_PUBLIC_URL=
# 视频处理临时目录（可选 · 默认 /tmp）
MEDITATION_TMP_DIR=

# 图片上传目录（封面/海报/公告）· 留空则默认项目根 uploads/ · nginx 反代 /uploads/ 到此
UPLOAD_DIR=

# ────────────────────────────────────────────────────────
# 推送 · Web Push (VAPID) · 浏览器 + Capacitor WebView
# 留空 → 推送功能 NOT_CONFIGURED（静默不发 · 不报错）
# 生成：npx web-push generate-vapid-keys
# ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 必须是 mailto: 或 https:// URI（默认 mailto:admin@juexue.local）
VAPID_SUBJECT=

# ────────────────────────────────────────────────────────
# 可观测 · Sentry（留空 → no-op · 5xx 仅落库无主动告警 · 上线务必配后端 DSN）
# ────────────────────────────────────────────────────────
SENTRY_DSN_BACKEND=
# 经 /api/config/public 暴露给前端 SDK
SENTRY_DSN_FRONTEND=
# 推荐设 git commit hash · 让 Sentry 按版本聚合（默认 dev）
SENTRY_RELEASE=

# ────────────────────────────────────────────────────────
# Bot 防护 · CAPTCHA（应用于 register / forgot / resend-verify）
# CAPTCHA_PROVIDER=none(默认·跳过校验·dev用) | turnstile | hcaptcha | recaptcha
# 选非 none 时务必填 SITE_KEY + SECRET_KEY，否则校验形同虚设
# ────────────────────────────────────────────────────────
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ────────────────────────────────────────────────────────
# 调度 / 限速 / 留存
# ────────────────────────────────────────────────────────
# 定时任务总开关（默认 true）· 多实例部署时只应一个实例开
CRON_ENABLED=true
# 全局每分钟限速上限（默认 0 = 不启用全局限速 · 仅 auth 路由有路由级限速）
# 上线建议显式设一个兜底值，如 600
GLOBAL_RATE_LIMIT_PER_MIN=0
# ErrorLog/DispatchLog 保留天数（默认 30）
LOG_RETENTION_DAYS=30
# AuditLog 保留天数（默认 0 = 永久保留供合规）
AUDIT_RETENTION_DAYS=0
